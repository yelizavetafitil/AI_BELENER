# Универсальный OCR. С NVIDIA GPU — лучше .env.gpu.example + ./scripts/up_ocr.sh
#
#   cp .env.ocr.example .env
#   ./scripts/up_ocr.sh

WEB_PORT=8090
WEB_MEM_LIMIT=6g
SURYA_MEM_LIMIT=10g

PDF_LOCAL_ONLY=1
PDF_REPORT_LLM=0
PDF_VISION_MODE=off

PDF_OCR_ENGINE=auto
SURYA_OCR_URL=http://surya-ocr:8081
SURYA_OCR_TIMEOUT=420
SURYA_DEVICE=auto
SURYA_MAX_SIDE=2048
PDF_OCR_FALLBACK_TESS=1
PDF_TILE_OCR_OFFLOAD=1
PDF_TILE_OCR_PARALLEL=2

PDF_GOST_CHECK_BUDGET=600
PDF_GOST_EXTRA_PER_PAGE_SEC=28
PDF_GOST_CHECK_BUDGET_MAX=14400
PDF_TILE_OCR_DPI=260

# 0 = ????????? ??? ????????? ?????????
PDF_STN_MAX_REFS=0

